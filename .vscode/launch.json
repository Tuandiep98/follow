{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Flutter Web",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "flutterMode": "debug",
      "deviceId": "chrome",
      "args": [
        "--web-port=8080",
        "--web-hostname=localhost",
        "--web-renderer=canvaskit"
      ]
    }
  ]
}